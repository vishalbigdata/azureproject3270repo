{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "df-azureproject3270"
		},
		"ls_adf_to_adlsgen2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adf_to_adlsgen2'"
		},
		"ls_azuresql_to_adf_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_azuresql_to_adf'"
		},
		"ls_adf_to_adlsgen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageazureproject3270.dfs.core.windows.net/"
		},
		"ls_azuresql_to_adf_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azureprojectserver21.database.windows.net"
		},
		"ls_azuresql_to_adf_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azureprojectdatabse"
		},
		"ls_azuresql_to_adf_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminvishal"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "df-azureproject3270_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adf_to_adlsgen2_accountKey": {
						"value": "[parameters('ls_adf_to_adlsgen2_accountKey')]"
					},
					"ls_azuresql_to_adf_password": {
						"value": "[parameters('ls_azuresql_to_adf_password')]"
					},
					"ls_adf_to_adlsgen2_properties_typeProperties_url": {
						"value": "[parameters('ls_adf_to_adlsgen2_properties_typeProperties_url')]"
					},
					"ls_azuresql_to_adf_properties_typeProperties_server": {
						"value": "[parameters('ls_azuresql_to_adf_properties_typeProperties_server')]"
					},
					"ls_azuresql_to_adf_properties_typeProperties_database": {
						"value": "[parameters('ls_azuresql_to_adf_properties_typeProperties_database')]"
					},
					"ls_azuresql_to_adf_properties_typeProperties_userName": {
						"value": "[parameters('ls_azuresql_to_adf_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}